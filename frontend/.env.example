# Laravel API base URL. Set this in Vercel → Project → Settings → Environment Variables.
VITE_API_URL=http://localhost:8000/api

# Public site address (no trailing slash), used for canonical / Open Graph links, robots.txt and sitemap.xml
VITE_SITE_URL=https://ycdc-navy.vercel.app

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA_ID=
