# Production template. Copy to .env on the server, fill in the blanks, then run:
#   php artisan key:generate && php artisan migrate --force
# Never commit the real .env.

APP_NAME=YCDC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ycdc.in

# Set to the load balancer IPs (or *) only if the server sits behind one
TRUSTED_PROXIES=

# Website origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://ycdc.in,https://www.ycdc.in,https://ycdc-navy.vercel.app

SANCTUM_EXPIRATION=480

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# First deploy only: initial password for the seeded staff accounts (change after login)
SEED_ADMIN_PASSWORD=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ycdc
DB_USERNAME=ycdc
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ycdc.in"
MAIL_FROM_NAME="YCDC Website"

# Branch inboxes that receive new website leads
LEAD_EMAIL_TRIVANDRUM=
LEAD_EMAIL_BANGALORE=
ADMIN_PORTAL_URL=https://ycdc.in/admin
